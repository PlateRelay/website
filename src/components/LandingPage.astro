---
import Diagram from './Diagram.astro';
import ProductPreview from './ProductPreview';
import { landing, type Lang } from '../i18n/landing';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const isZh = lang === 'zh-cn';
const t = landing[lang];
const docsBase = isZh ? '/zh-cn/docs' : '/docs';
const svgSuffix = isZh ? '' : '-en';
const githubUrl = 'https://github.com/PlateRelay/PlateRelay';

const eyebrowClass = ['text-xs font-semibold tracking-wider', { uppercase: !isZh }];
const cardClass =
  'rounded-2xl border border-[var(--pr-line)] bg-[var(--pr-card)] p-6 transition-colors duration-200 hover:border-[var(--pr-line2)]';
---

<!-- Hero + product preview -->
<section class="border-b border-[var(--pr-line)] bg-[var(--pr-bg)]">
  <div class="mx-auto max-w-[1120px] px-5 pb-16 pt-14 sm:px-8 sm:pb-24 sm:pt-20">
    <div class="mx-auto max-w-3xl text-center">
      <div class="pr-fade-up inline-flex items-center gap-2 rounded-full border border-[var(--pr-line)] bg-[var(--pr-sub)] px-3 py-1 text-xs font-medium text-[var(--pr-fg2)]">
        <span class="pr-breathe h-1.5 w-1.5 rounded-full" style="background: var(--pr-ok-d)"></span>
        <span>{t.hero.status}</span>
      </div>

      <h1 class="pr-fade-up pr-delay-1 mt-5 whitespace-pre-line text-3xl font-bold tracking-tight text-[var(--pr-fg)] sm:text-5xl sm:leading-[1.12]">
        {t.hero.title}
      </h1>

      <p class="pr-fade-up pr-delay-2 mx-auto mt-4 max-w-2xl text-[15px] leading-relaxed text-[var(--pr-muted)] sm:text-base">
        {t.hero.subtitle}
      </p>

      <div class="pr-fade-up pr-delay-3 mt-7 flex flex-wrap items-center justify-center gap-3">
        <a
          href={`${docsBase}/getting-started/`}
          class="group inline-flex h-10 items-center gap-2 rounded-full bg-[var(--pr-ink)] px-5 text-sm font-semibold text-[var(--pr-ink-fg)] transition-opacity hover:opacity-90"
        >
          <span>{t.hero.primary}</span>
          <span aria-hidden="true" class="inline-block transition-transform duration-200 group-hover:translate-x-0.5">→</span>
        </a>
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-10 items-center gap-2 rounded-full border border-[var(--pr-line)] bg-[var(--pr-card)] px-5 text-sm font-semibold text-[var(--pr-fg)] transition-colors hover:border-[var(--pr-line2)]"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.57.11.78-.25.78-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.39-5.26 5.67.41.36.78 1.06.78 2.14 0 1.55-.01 2.8-.01 3.18 0 .31.21.67.79.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
          </svg>
          <span>{t.hero.secondary}</span>
        </a>
      </div>
    </div>

    <div class="pr-demo-settle">
      <ProductPreview client:idle lang={lang} />
    </div>
  </div>
</section>

<!-- Workflow -->
<section id="workflow" class="border-b border-[var(--pr-line)] bg-[var(--pr-band)]">
  <div data-reveal class="pr-reveal mx-auto max-w-[1120px] px-5 py-16 sm:px-8 sm:py-20">
    <div class="max-w-3xl">
      <div class:list={eyebrowClass} style="color: var(--pr-busy-t)">{t.workflow.eyebrow}</div>
      <h2 class="mt-2 text-pretty text-2xl font-bold tracking-tight text-[var(--pr-fg)] sm:text-3xl">{t.workflow.title}</h2>
      <p class="mt-2.5 text-sm leading-relaxed text-[var(--pr-muted)] sm:text-base">{t.workflow.subtitle}</p>
    </div>

    <Diagram name="workflow" suffix={svgSuffix} alt={t.workflow.alt} wide={[964, 136]} tall={[320, 460]} />
  </div>
</section>

<!-- Features -->
<section id="features" class="border-b border-[var(--pr-line)] bg-[var(--pr-bg)]">
  <div data-reveal class="pr-reveal mx-auto max-w-[1120px] px-5 py-16 sm:px-8 sm:py-20">
    <div class="max-w-3xl">
      <div class:list={eyebrowClass} style="color: var(--pr-busy-t)">{t.features.eyebrow}</div>
      <h2 class="mt-2 text-pretty text-2xl font-bold tracking-tight text-[var(--pr-fg)] sm:text-3xl">{t.features.title}</h2>
    </div>

    <div class="mt-8 grid gap-5 md:grid-cols-2">
      {t.features.items.map((card) => (
        <div class={cardClass}>
          <div class="inline-flex h-9 w-9 items-center justify-center rounded-xl border border-[var(--pr-line)] bg-[var(--pr-sub)] text-[var(--pr-fg)]">
            {card.icon === 'pool' && (
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
                <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
              </svg>
            )}
            {card.icon === 'shield' && (
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
                <path d="m9 12 2 2 4-4" />
              </svg>
            )}
            {card.icon === 'audit' && (
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="8" height="4" x="8" y="2" rx="1" ry="1" />
                <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
                <path d="m9 14 2 2 4-4" />
              </svg>
            )}
            {card.icon === 'lock' && (
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
              </svg>
            )}
          </div>
          <h3 class="mt-4 text-base font-semibold text-[var(--pr-fg)]">{card.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--pr-muted)]">{card.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Architecture -->
<section id="architecture" class="border-b border-[var(--pr-line)] bg-[var(--pr-band)]">
  <div data-reveal class="pr-reveal mx-auto max-w-[1120px] px-5 py-16 sm:px-8 sm:py-20">
    <div class="max-w-3xl">
      <div class:list={eyebrowClass} style="color: var(--pr-busy-t)">{t.architecture.eyebrow}</div>
      <h2 class="mt-2 text-pretty text-2xl font-bold tracking-tight text-[var(--pr-fg)] sm:text-3xl">{t.architecture.title}</h2>
      <p class="mt-2.5 text-sm leading-relaxed text-[var(--pr-muted)] sm:text-base">{t.architecture.subtitle}</p>
    </div>

    <Diagram name="architecture" suffix={svgSuffix} alt={t.architecture.alt} wide={[964, 252]} tall={[336, 424]} />

    <div class="mt-5 grid gap-5 md:grid-cols-3">
      {t.architecture.items.map((item) => (
        <div class={cardClass}>
          <h3 class="text-base font-semibold text-[var(--pr-fg)]">{item.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--pr-muted)]">{item.desc}</p>
        </div>
      ))}
    </div>

    <a
      href={`${docsBase}/architecture/`}
      class="group mt-6 inline-flex items-center gap-1 text-sm font-semibold hover:underline"
      style="color: var(--pr-busy-t)"
    >
      <span>{t.architecture.link}</span>
      <span aria-hidden="true" class="inline-block transition-transform duration-200 group-hover:translate-x-0.5">→</span>
    </a>
  </div>
</section>

<!-- Roadmap -->
<section id="roadmap" class="bg-[var(--pr-bg)]">
  <div data-reveal class="pr-reveal mx-auto max-w-[1120px] px-5 py-16 sm:px-8 sm:py-20">
    <div class="max-w-3xl">
      {t.roadmap.eyebrow && <div class:list={eyebrowClass} style="color: var(--pr-busy-t)">{t.roadmap.eyebrow}</div>}
      <h2 class="mt-2 text-pretty text-2xl font-bold tracking-tight text-[var(--pr-fg)] sm:text-3xl">{t.roadmap.title}</h2>
      <p class="mt-2.5 text-sm leading-relaxed text-[var(--pr-muted)] sm:text-base">{t.roadmap.subtitle}</p>
    </div>

    <ol class="mt-8 divide-y divide-[var(--pr-line)] rounded-2xl border border-[var(--pr-line)] bg-[var(--pr-card)]">
      {t.roadmap.items.map((item) => (
        <li class="flex items-start gap-3.5 p-5">
          {item.done ? (
            <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full" style="background: var(--pr-ok-s); color: var(--pr-ok-t);">
              <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 6 9 17l-5-5" />
              </svg>
            </span>
          ) : (
            <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-[var(--pr-sub)] text-[var(--pr-muted)]">
              <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="12" cy="12" r="7" />
              </svg>
            </span>
          )}
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="text-sm font-semibold text-[var(--pr-fg)]">{item.title}</h3>
              {item.done && (
                <span class="rounded-full px-2 py-0.5 text-[10px] font-semibold" style="background: var(--pr-ok-s); color: var(--pr-ok-t);">
                  {t.roadmap.doneLabel}
                </span>
              )}
            </div>
            <p class="mt-1 text-sm leading-relaxed text-[var(--pr-muted)]">{item.desc}</p>
          </div>
        </li>
      ))}
    </ol>

    <a
      href={`${docsBase}/getting-started/`}
      class="group mt-6 inline-flex items-center gap-1 text-sm font-semibold hover:underline"
      style="color: var(--pr-busy-t)"
    >
      <span>{t.roadmap.link}</span>
      <span aria-hidden="true" class="inline-block transition-transform duration-200 group-hover:translate-x-0.5">→</span>
    </a>
  </div>
</section>
