---
import ProductPreview from './ProductPreview';
import QuickStartBlock from './QuickStartBlock';

interface Props {
  lang: 'en' | 'zh-cn';
}

const { lang } = Astro.props;
const isZh = lang === 'zh-cn';
const docsBase = isZh ? '/zh-cn/docs' : '/docs';

const t = isZh
  ? {
      statusTag: '早期开发阶段 · GPL-3.0-only · 欢迎贡献',
      headline: '面向公共共享场景的\n自托管 3D 打印管理平台',
      subtitle:
        '专为黑客松、创客空间与高校实验室构建。将切片上传校验、人工审核、队列调度、内网设备隔离与凭码取件串联成可审计的工作闭环。',
      ctaPrimary: '阅读文档',
      ctaGithub: '查看 GitHub',
      whyEyebrow: '为什么需要 PlateRelay',
      whyTitle: '公共共享打印资源，不能直接套用私有打印农场',
      whyRows: [
        {
          num: '01',
          dim: '资源属性',
          now: '多方共享的公共打印池',
          old: '传统打印农场面向单方私有集群，缺少跨团队边界。',
        },
        {
          num: '02',
          dim: '角色隔离',
          now: '用户与物理打印机彻底隔离',
          old: '普通用户只提交 .gcode.3mf 与凭码取件，无法接触打印机后台或局域网。',
        },
        {
          num: '03',
          dim: '审核与审计',
          now: '人工审核门槛 + 分权限审计日志',
          old: '所有提交先过审核关，调度、操作与驳回原因均可追溯。',
        },
        {
          num: '04',
          dim: '交付闭环',
          now: '入库并确认清床后才释放设备',
          old: '打印完成不会立即解锁机器，确认清床防撞件后再生成核销取件码。',
        },
      ],
      archEyebrow: '核心流程与架构',
      archTitle: '6 步交付闭环，与「面板 + 局域网 Daemon」分离部署',
      steps: [
        { n: '01', label: '提交 .gcode.3mf' },
        { n: '02', label: '人工审核' },
        { n: '03', label: '规则队列调度' },
        { n: '04', label: '内网 Daemon 派单打印' },
        { n: '05', label: '入库并确认清床释放设备' },
        { n: '06', label: '凭码核销取件' },
      ],
      archCards: [
        {
          tag: 'apps/server · apps/web · packages/shared',
          title: '中心管理面板（Panel）',
          desc: '基于 NestJS + React + PostgreSQL，负责账户鉴权、Worker 线程切片解析校验、审核工作台、队列调度、SSE 实时推送与取件核销。',
          href: `${docsBase}/server/`,
          link: '面板后端文档 →',
        },
        {
          tag: 'daemon/src/platerelay_daemon · platerelay_sim',
          title: '局域网守护进程（Daemon）',
          desc: '基于 Python 3.12 + SQLite 出站队列，部署于打印机所在局域网并主动通过 WebSocket 连接面板，无需开放任何内网入站端口；内置高倍速模拟打印机用于三端联调。',
          href: `${docsBase}/daemon/`,
          link: 'Daemon 与模拟器文档 →',
        },
      ],
      quickEyebrow: '本地开发体验',
      quickTitle: '默认内置 PGlite 与本地存储，无需外部数据库',
      quickDesc:
        '项目暂未发布生产安装包与 Docker Compose，现阶段可通过本地环境预览前端原型，或配合内置模拟打印机完成三端联调。',
      quickLink: '查看完整快速开始与测试命令 →',
      roadmapTitle: '开发路线图',
      roadmap: [
        {
          done: true,
          title: '核心契约与基础框架',
          desc: 'OpenAPI 与 daemon 通信协议、面板后端核心工作流、守护进程框架与内置模拟打印机。',
        },
        {
          done: false,
          title: 'v1 完整可用',
          desc: '前端契约适配、完整文件安全校验、拓竹设备驱动、媒体能力、外部登录与通知及 Docker Compose。',
        },
        {
          done: false,
          title: '多品牌设备驱动',
          desc: '扩展 Klipper / Moonraker、PrusaLink、OctoPrint 等主流固件与协议支持。',
        },
        {
          done: false,
          title: '场地运营与开放集成',
          desc: '暂存库位与耗材库存管理、公开 REST API、受限个人访问令牌（PAT）与事件 Webhook。',
        },
      ],
    }
  : {
      statusTag: 'Early Development · GPL-3.0-only · Open Source',
      headline: 'Self-hosted 3D printing\nfor shared public fleets',
      subtitle:
        'Built for hackathons, makerspaces, and university labs. Connect .gcode.3mf validation, manual review, queued dispatch, outbound LAN daemons, and code-verified pickup into one auditable loop.',
      ctaPrimary: 'Read the Docs',
      ctaGithub: 'View on GitHub',
      whyEyebrow: 'Why PlateRelay',
      whyTitle: 'Shared printing spaces need stronger boundaries than private print farms',
      whyRows: [
        {
          num: '01',
          dim: 'Resource Model',
          now: 'Multi-user shared printing pool',
          old: 'Traditional print farm tools assume a single-owner private fleet with trusted direct access.',
        },
        {
          num: '02',
          dim: 'Hardware Isolation',
          now: 'Users never touch physical printers or LANs',
          old: 'Participants only submit sliced .gcode.3mf files and redeem parts with short pickup codes.',
        },
        {
          num: '03',
          dim: 'Review & Audit',
          now: 'Manual review gate + scoped audit trails',
          old: 'Every order passes review before dispatch, with permission-controlled logs for every state change.',
        },
        {
          num: '04',
          dim: 'Fulfillment Loop',
          now: 'Printers release only after bed clearance',
          old: 'Finishing a print does not unlock the machine until staff shelve the part and confirm an empty bed.',
        },
      ],
      archEyebrow: 'Workflow & Architecture',
      archTitle: '6-stage fulfillment loop over a split Panel + LAN Daemon architecture',
      steps: [
        { n: '01', label: 'Submit .gcode.3mf' },
        { n: '02', label: 'Manual Review' },
        { n: '03', label: 'Queue Scheduling' },
        { n: '04', label: 'Daemon Dispatch & Print' },
        { n: '05', label: 'Shelve & Confirm Bed Clear' },
        { n: '06', label: 'Code-Verified Pickup' },
      ],
      archCards: [
        {
          tag: 'apps/server · apps/web · packages/shared',
          title: 'Central Management Panel',
          desc: 'Powered by NestJS, React, and PostgreSQL. Handles authentication, worker-thread .gcode.3mf parsing, review queues, job dispatch, SSE live streams, and pickup verification.',
          href: `${docsBase}/server/`,
          link: 'Panel Server docs →',
        },
        {
          tag: 'daemon/src/platerelay_daemon · platerelay_sim',
          title: 'Outbound LAN Daemon',
          desc: 'Written in Python 3.12 with SQLite outbox durability. Runs inside the printer LAN and connects outbound over WebSocket—zero inbound ports needed. Ships with a built-in simulated printer.',
          href: `${docsBase}/daemon/`,
          link: 'Daemon & Simulator docs →',
        },
      ],
      quickEyebrow: 'Local Development',
      quickTitle: 'Zero external services needed to try it locally',
      quickDesc:
        'Production packages and Docker Compose are not published yet. Local development defaults to embedded PGlite and local storage, with a high-speed simulated printer included.',
      quickLink: 'Read Getting Started & test commands →',
      roadmapTitle: 'Roadmap',
      roadmap: [
        {
          done: true,
          title: 'Core Contracts & Foundation',
          desc: 'OpenAPI & daemon protocol schemas, core backend workflow engine, daemon framework, and built-in simulated printer.',
        },
        {
          done: false,
          title: 'v1 Release',
          desc: 'Web contract integration, complete file safety validation, Bambu Lab driver, media pipeline, external auth & Docker Compose.',
        },
        {
          done: false,
          title: 'Multi-Brand Printer Drivers',
          desc: 'Extend adapter support for Klipper / Moonraker, PrusaLink, and OctoPrint fleets.',
        },
        {
          done: false,
          title: 'Operations & Open Integrations',
          desc: 'Staging shelf & filament inventory management, scoped PATs, event webhooks, and external portal adapters.',
        },
      ],
    };
---

<!-- Section 1: Editorial Hero + Authentic PlateRelay UI Preview -->
<section class="border-b border-[var(--pr-line)]">
  <div class="mx-auto max-w-[1160px] border-x border-[var(--pr-line)] px-4 pb-16 pt-12 sm:px-8 sm:pb-20 sm:pt-16">
    <div class="mx-auto max-w-3xl text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-[var(--pr-line)] bg-[var(--pr-sub)] px-3 py-1 text-xs font-medium text-[var(--pr-fg2)]">
        <span class="h-1.5 w-1.5 rounded-full" style="background: var(--pr-ok-d)"></span>
        <span>{t.statusTag}</span>
      </div>

      <h1 class="mt-5 whitespace-pre-line text-3xl font-bold tracking-tight text-[var(--pr-fg)] sm:text-5xl sm:leading-[1.12]">
        {t.headline}
      </h1>

      <p class="mx-auto mt-4 max-w-2xl text-[15px] leading-relaxed text-[var(--pr-muted)] sm:text-base">
        {t.subtitle}
      </p>

      <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
        <a
          href={`${docsBase}/overview/`}
          class="inline-flex h-10 items-center gap-2 rounded-full bg-[var(--pr-ink)] px-5 text-sm font-semibold text-[var(--pr-ink-fg)] transition-opacity hover:opacity-90 no-underline"
        >
          <span>{t.ctaPrimary}</span>
          <span aria-hidden="true">→</span>
        </a>
        <a
          href="https://github.com/PlateRelay/PlateRelay"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-10 items-center rounded-full border border-[var(--pr-line)] bg-[var(--pr-card)] px-5 text-sm font-semibold text-[var(--pr-fg)] transition-colors hover:border-[var(--pr-line2)] no-underline"
        >
          {t.ctaGithub}
        </a>
      </div>
    </div>

    <ProductPreview client:load lang={lang} />
  </div>
</section>

<!-- Section 2: Why PlateRelay (1px Precision Grid) -->
<section class="border-b border-[var(--pr-line)] bg-[var(--pr-bg)]">
  <div class="mx-auto max-w-[1160px] border-x border-[var(--pr-line)]">
    <div class="border-b border-[var(--pr-line)] px-4 py-10 sm:px-8">
      <div class="font-mono text-xs font-medium uppercase tracking-wider text-[var(--pr-muted)]">
        {t.whyEyebrow}
      </div>
      <h2 class="mt-2 max-w-2xl text-2xl font-bold tracking-tight text-[var(--pr-fg)] sm:text-3xl">
        {t.whyTitle}
      </h2>
    </div>

    <div class="grid divide-y divide-[var(--pr-line)] sm:grid-cols-2 sm:divide-x lg:grid-cols-4 lg:divide-y-0">
      {t.whyRows.map((row) => (
        <div class="flex flex-col justify-between gap-4 p-6">
          <div>
            <div class="flex items-center justify-between text-xs text-[var(--pr-muted)]">
              <span class="font-semibold">{row.dim}</span>
              <span class="font-mono text-[var(--pr-faint)]">{row.num}</span>
            </div>
            <h3 class="mt-3 text-[15px] font-semibold leading-snug text-[var(--pr-fg)]">
              {row.now}
            </h3>
          </div>
          <p class="text-xs leading-relaxed text-[var(--pr-muted)]">{row.old}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Section 3: 6-Stage Workflow & Split Architecture -->
<section id="architecture" class="border-b border-[var(--pr-line)] bg-[var(--pr-page)]">
  <div class="mx-auto max-w-[1160px] border-x border-[var(--pr-line)] px-4 py-14 sm:px-8 sm:py-16">
    <div class="max-w-2xl">
      <div class="font-mono text-xs font-medium uppercase tracking-wider text-[var(--pr-muted)]">
        {t.archEyebrow}
      </div>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-[var(--pr-fg)] sm:text-3xl">
        {t.archTitle}
      </h2>
    </div>

    <!-- 6-Stage Numbered Pipeline -->
    <ol class="mt-8 grid grid-cols-2 overflow-hidden rounded-2xl border border-[var(--pr-line)] bg-[var(--pr-card)] sm:grid-cols-3 lg:grid-cols-6">
      {t.steps.map((step, idx) => (
        <li
          class={`flex flex-col justify-between gap-2 p-4 ${
            idx < t.steps.length - 1 ? 'border-b border-r border-[var(--pr-line)] lg:border-b-0' : ''
          }`}
        >
          <span class="font-mono text-[11px] font-semibold text-[var(--pr-faint)]">{step.n}</span>
          <span class="text-[13px] font-semibold leading-snug text-[var(--pr-fg)]">
            {step.label}
          </span>
        </li>
      ))}
    </ol>

    <!-- Panel vs Outbound LAN Daemon -->
    <div class="mt-4 grid gap-4 md:grid-cols-2">
      {t.archCards.map((card) => (
        <div class="flex flex-col justify-between rounded-2xl border border-[var(--pr-line)] bg-[var(--pr-card)] p-6">
          <div>
            <div class="font-mono text-[11px] text-[var(--pr-muted)]">{card.tag}</div>
            <h3 class="mt-2 text-lg font-bold tracking-tight text-[var(--pr-fg)]">
              {card.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--pr-muted)]">{card.desc}</p>
          </div>
          <a
            href={card.href}
            class="mt-5 inline-flex items-center text-sm font-semibold text-[var(--pr-fg)] hover:underline no-underline"
          >
            {card.link}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Section 4: Local Quick Start & Roadmap -->
<section id="roadmap" class="bg-[var(--pr-bg)]">
  <div class="mx-auto grid max-w-[1160px] gap-10 border-x border-[var(--pr-line)] px-4 py-14 sm:px-8 sm:py-16 lg:grid-cols-12">
    <div class="lg:col-span-6">
      <div class="font-mono text-xs font-medium uppercase tracking-wider text-[var(--pr-muted)]">
        {t.quickEyebrow}
      </div>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-[var(--pr-fg)]">
        {t.quickTitle}
      </h2>
      <p class="mt-2.5 text-sm leading-relaxed text-[var(--pr-muted)]">{t.quickDesc}</p>

      <div class="mt-5">
        <QuickStartBlock client:load lang={lang} />
      </div>

      <a
        href={`${docsBase}/getting-started/`}
        class="mt-4 inline-flex items-center text-sm font-semibold text-[var(--pr-fg)] hover:underline no-underline"
      >
        {t.quickLink}
      </a>
    </div>

    <div class="lg:col-span-6">
      <div class="font-mono text-xs font-medium uppercase tracking-wider text-[var(--pr-muted)]">
        {t.roadmapTitle}
      </div>
      <div class="mt-5 divide-y divide-[var(--pr-line)] rounded-2xl border border-[var(--pr-line)] bg-[var(--pr-card)]">
        {t.roadmap.map((item) => (
          <div class="flex items-start gap-3 p-4">
            <span
              class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full text-[11px] font-bold"
              style={
                item.done
                  ? 'background: var(--pr-ok-s); color: var(--pr-ok-t);'
                  : 'background: var(--pr-sub); color: var(--pr-muted);'
              }
            >
              {item.done ? '✓' : '○'}
            </span>
            <div>
              <h3 class="text-sm font-semibold text-[var(--pr-fg)]">{item.title}</h3>
              <p class="mt-1 text-xs leading-relaxed text-[var(--pr-muted)]">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
