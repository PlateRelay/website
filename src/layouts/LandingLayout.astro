---
import '../styles/global.css';
import { landing, type Lang } from '../i18n/landing';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const n = landing[lang].nav;
const { title, description } = landing[lang].meta;
const footerTagline = landing[lang].footer.tagline;
const isZh = lang === 'zh-cn';
const htmlLang = isZh ? 'zh-CN' : 'en';
const homeHref = isZh ? '/zh-cn/' : '/';
const overviewHref = isZh ? '/zh-cn/docs/overview/' : '/docs/overview/';
const archHref = isZh ? '/zh-cn/docs/architecture/' : '/docs/architecture/';
const otherLangHref = isZh ? '/' : '/zh-cn/';
const site = Astro.site ?? new URL('https://platerelay.app');
const canonical = new URL(homeHref, site).href;
const enHref = new URL('/', site).href;
const zhHref = new URL('/zh-cn/', site).href;
---

<!doctype html>
<html lang={htmlLang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="zh-CN" href={zhHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PlateRelay" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={isZh ? 'zh_CN' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (() => {
        document.documentElement.classList.add('pr-js');
        let stored = null;
        try {
          stored = localStorage.getItem('starlight-theme');
        } catch {}
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = stored === 'light' || stored === 'dark' ? stored : prefersDark ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class="pr-landing min-h-screen bg-[var(--pr-bg)] text-[var(--pr-fg)] antialiased selection:bg-[var(--pr-busy-s)] selection:text-[var(--pr-busy-t)]">
    <header class="sticky top-0 z-50 border-b border-[var(--pr-line)] bg-[var(--pr-bg)]/90 backdrop-blur-md">
      <div class="mx-auto flex h-15 max-w-[1120px] items-center justify-between gap-4 px-5 sm:px-8">
        <a href={homeHref} class="flex items-center gap-2.5 text-[var(--pr-fg)]">
          <img src="/favicon.svg" alt="PlateRelay" class="h-7 w-7 rounded-lg" />
          <span class="text-[15px] font-bold tracking-tight">PlateRelay</span>
        </a>

        <nav class="hidden items-center gap-7 text-sm font-medium text-[var(--pr-muted)] md:flex">
          <a href={overviewHref} class="transition-colors hover:text-[var(--pr-fg)]">
            {n.docs}
          </a>
          <a href="#architecture" class="transition-colors hover:text-[var(--pr-fg)]">
            {n.architecture}
          </a>
          <a href="#roadmap" class="transition-colors hover:text-[var(--pr-fg)]">
            {n.roadmap}
          </a>
        </nav>

        <div class="flex items-center gap-2">
          <a
            href={otherLangHref}
            class="hidden h-8 items-center md:inline-flex rounded-full border border-[var(--pr-line)] bg-[var(--pr-card)] px-3 text-xs font-medium text-[var(--pr-fg2)] transition-colors hover:border-[var(--pr-line2)] hover:text-[var(--pr-fg)]"
            title={n.switchLangTitle}
          >
            {n.switchLangShort}
          </a>

          <button
            type="button"
            id="pr-theme-toggle"
            aria-label={n.toggleTheme}
            class="inline-flex h-8 w-8 cursor-pointer items-center justify-center rounded-full border border-[var(--pr-line)] bg-[var(--pr-card)] text-[var(--pr-fg2)] transition-colors hover:border-[var(--pr-line2)] hover:text-[var(--pr-fg)]"
          >
            <svg class="pr-icon-sun hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2"></path><path d="M12 20v2"></path>
              <path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path>
              <path d="M2 12h2"></path><path d="M20 12h2"></path>
              <path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path>
            </svg>
            <svg class="pr-icon-moon hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
            </svg>
          </button>

          <a
            href="https://github.com/PlateRelay/PlateRelay"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-8 items-center gap-1.5 rounded-full bg-[var(--pr-ink)] px-3.5 text-xs font-semibold text-[var(--pr-ink-fg)] transition-opacity hover:opacity-90"
          >
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.57.11.78-.25.78-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.39-5.26 5.67.41.36.78 1.06.78 2.14 0 1.55-.01 2.8-.01 3.18 0 .31.21.67.79.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
            </svg>
            <span>GitHub</span>
          </a>

          <button
            type="button"
            id="pr-menu-toggle"
            aria-label={n.openMenu}
            aria-expanded="false"
            aria-controls="pr-mobile-menu"
            class="inline-flex h-8 w-8 cursor-pointer items-center justify-center rounded-full border border-[var(--pr-line)] bg-[var(--pr-card)] text-[var(--pr-fg2)] transition-colors hover:border-[var(--pr-line2)] hover:text-[var(--pr-fg)] md:hidden"
          >
            <svg class="pr-icon-menu h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 7h16"></path><path d="M4 12h16"></path><path d="M4 17h16"></path>
            </svg>
            <svg class="pr-icon-close hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 6 6 18"></path><path d="m6 6 12 12"></path>
            </svg>
          </button>
        </div>
      </div>

      <nav
        id="pr-mobile-menu"
        hidden
        class="border-t border-[var(--pr-line)] px-5 py-2 text-[15px] font-medium text-[var(--pr-fg)] sm:px-8 md:hidden"
      >
        <a href={overviewHref} class="block py-2.5">{n.docs}</a>
        <a href="#architecture" class="block py-2.5">{n.architecture}</a>
        <a href="#roadmap" class="block py-2.5">{n.roadmap}</a>
        <a href={otherLangHref} class="block border-t border-[var(--pr-line)] py-2.5 text-[var(--pr-fg2)]">
          {n.switchLang}
        </a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-[var(--pr-line)] bg-[var(--pr-bg)]">
      <div class="mx-auto flex max-w-[1120px] flex-col gap-4 px-5 py-8 text-xs text-[var(--pr-muted)] sm:flex-row sm:items-center sm:justify-between sm:px-8">
        <div class="flex flex-wrap items-center gap-2.5">
          <img src="/favicon.svg" alt="" class="h-5 w-5 rounded" />
          <span class="font-semibold text-[var(--pr-fg)]">PlateRelay</span>
          <span class="text-[var(--pr-faint)]">·</span>
          <span>{footerTagline}</span>
          <span class="rounded border border-[var(--pr-line)] px-1.5 py-0.5 font-mono text-[10px]">
            GPL-3.0-only
          </span>
        </div>
        <div class="flex flex-wrap items-center gap-5">
          <a href={overviewHref} class="transition-colors hover:text-[var(--pr-fg)]">{n.docs}</a>
          <a href={archHref} class="transition-colors hover:text-[var(--pr-fg)]">{n.architecture}</a>
          <a href="https://github.com/PlateRelay/PlateRelay" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-[var(--pr-fg)]">GitHub</a>
          <a href="https://github.com/PlateRelay/PlateRelay/issues" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-[var(--pr-fg)]">Issues</a>
          <a href={otherLangHref} class="transition-colors hover:text-[var(--pr-fg)]">{n.switchLang}</a>
        </div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const btn = document.getElementById('pr-menu-toggle');
        const menu = document.getElementById('pr-mobile-menu');
        if (!btn || !menu) return;
        const setOpen = (open) => {
          menu.hidden = !open;
          btn.setAttribute('aria-expanded', String(open));
          btn.querySelector('.pr-icon-menu')?.classList.toggle('hidden', open);
          btn.querySelector('.pr-icon-close')?.classList.toggle('hidden', !open);
        };
        btn.addEventListener('click', () => setOpen(menu.hidden));
        menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
      })();

      (() => {
        const btn = document.getElementById('pr-theme-toggle');
        if (!btn) return;
        const sun = btn.querySelector('.pr-icon-sun');
        const moon = btn.querySelector('.pr-icon-moon');
        const syncIcons = (theme) => {
          if (theme === 'dark') {
            sun?.classList.remove('hidden');
            moon?.classList.add('hidden');
          } else {
            sun?.classList.add('hidden');
            moon?.classList.remove('hidden');
          }
        };
        syncIcons(document.documentElement.dataset.theme || 'light');
        btn.addEventListener('click', () => {
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          try {
            localStorage.setItem('starlight-theme', next);
          } catch {}
          syncIcons(next);
        });
      })();

      (() => {
        const nodes = document.querySelectorAll('[data-reveal]');
        if (!nodes.length) return;
        const show = (el) => el.classList.add('is-visible');
        if (typeof IntersectionObserver === 'undefined') {
          nodes.forEach(show);
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                show(entry.target);
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.08, rootMargin: '0px 0px -32px 0px' },
        );
        nodes.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
